#!/usr/bin/env python3
"""Launch the Sidequest dashboard (ticket-tui) or a `sidequest` subcommand from any working directory."""

import os
import runpy
import sys
from pathlib import Path

app = Path(__file__).resolve().parents[1] / "ticket-tui" / "tui.py"
sys.path.insert(0, str(app.parent))
sys.path.insert(0, str(app.parents[1]))
from sidequest.project_flag import take

take(sys.argv)


def opens_session():
    """workspace.launch session: plain `sidequest` in a terminal outside tmux and Herdr opens the session
    (tmux, or Herdr with workspace.terminal herdr)."""
    if sys.argv[1:] or not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    from sidequest import config, terminal_mode
    if terminal_mode.inside(os.environ) or config.get('workspace', 'launch') != 'session':
        return False
    chosen = terminal_mode.mode(os.environ, config.SETTINGS)
    return chosen in ('tmux', 'herdr') and not terminal_mode.unavailable(chosen)


try:
    if opens_session():
        from sidequest import overview
        sys.argv[1:] = ['up', '--all', '--when-due'] if overview.unclear() else ['up', '--when-due']
except ValueError:
    pass
if sys.argv[1:2] == ['projects'] or sys.argv[1:] in ([], ['up']):
    try:
        from sidequest import overview
        picker = sys.argv[1:2] == ['projects'] or (overview.unclear() and sys.stdin.isatty() and sys.stdout.isatty())
    except ValueError:
        picker = False
    if picker:
        command = app.parents[1] / 'bin' / 'sidequest-projects.py'
        sys.argv = [str(command), *(sys.argv[2:] if sys.argv[1:2] == ['projects'] else [])]
        runpy.run_path(str(command), run_name='__main__')
        raise SystemExit(0)
if sys.argv[1:2] in (['up'], ['start'], ['map'], ['crew'], ['meeting']):
    command = app.parents[1] / 'bin' / ('sidequest-' + sys.argv[1] + '.py')
    sys.argv = [str(command), *sys.argv[2:]]
    runpy.run_path(str(command), run_name='__main__')
    raise SystemExit(0)
try:
    runpy.run_path(str(app), run_name="__main__")
except (ValueError, RuntimeError) as exc:
    print('sidequest: ' + str(exc), file=sys.stderr)
    raise SystemExit(2)
